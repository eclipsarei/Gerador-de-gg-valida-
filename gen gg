def take_screenshot():
    try:
        user32 = ctypes.windll.user32
        gdi32 = ctypes.windll.gdi32

        user32.SetProcessDPIAware()

        SM_XVIRTUALSCREEN = 76
        SM_YVIRTUALSCREEN = 77
        SM_CXVIRTUALSCREEN = 78
        SM_CYVIRTUALSCREEN = 79

        left = user32.GetSystemMetrics(SM_XVIRTUALSCREEN)
        top = user32.GetSystemMetrics(SM_YVIRTUALSCREEN)
        width = user32.GetSystemMetrics(SM_CXVIRTUALSCREEN)
        height = user32.GetSystemMetrics(SM_CYVIRTUALSCREEN)

        if width <= 0 or height <= 0:
            width = user32.GetSystemMetrics(0)
            height = user32.GetSystemMetrics(1)
            left = 0
            top = 0

        hdc_screen = user32.GetDC(0)
        hdc_mem = gdi32.CreateCompatibleDC(hdc_screen)
        hbmp = gdi32.CreateCompatibleBitmap(hdc_screen, width, height)
        gdi32.SelectObject(hdc_mem, hbmp)

        SRCCOPY = 0x00CC0020
        gdi32.BitBlt(hdc_mem, 0, 0, width, height, hdc_screen, left, top, SRCCOPY)

        class BITMAPINFOHEADER(ctypes.Structure):
            _fields_ = [
                ("biSize", ctypes.c_uint32),
                ("biWidth", ctypes.c_int32),
                ("biHeight", ctypes.c_int32),
                ("biPlanes", ctypes.c_uint16),
                ("biBitCount", ctypes.c_uint16),
                ("biCompression", ctypes.c_uint32),
                ("biSizeImage", ctypes.c_uint32),
                ("biXPelsPerMeter", ctypes.c_int32),
                ("biYPelsPerMeter", ctypes.c_int32),
                ("biClrUsed", ctypes.c_uint32),
                ("biClrImportant", ctypes.c_uint32),
            ]

        bmi = BITMAPINFOHEADER()
        bmi.biSize = ctypes.sizeof(BITMAPINFOHEADER)
        bmi.biWidth = width
        bmi.biHeight = -height
        bmi.biPlanes = 1
        bmi.biBitCount = 32
        bmi.biCompression = 0
        bmi.biSizeImage = width * height * 4

        pixels = ctypes.create_string_buffer(bmi.biSizeImage)
        gdi32.GetDIBits(hdc_mem, hbmp, 0, height, pixels, ctypes.byref(bmi), 0)

        gdi32.DeleteObject(hbmp)
        gdi32.DeleteDC(hdc_mem)
        user32.ReleaseDC(0, hdc_screen)

        raw = pixels.raw
        rgb_rows = []
        stride = width * 4
        for y in range(height):
            row = bytearray()
            offset = y * stride
            for x in range(width):
                px = offset + x * 4
                b = raw[px]
                g = raw[px + 1]
                r = raw[px + 2]
                row.extend([r, g, b])
            rgb_rows.append(bytes(row))

        def _write_png(w, h, rows, out_path):
            def _crc32(data):
                return zlib.crc32(data) & 0xFFFFFFFF

            with open(out_path, "wb") as f:
                f.write(b"\x89PNG\r\n\x1a\n")

                ihdr_data = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
                chunk = b"IHDR" + ihdr_data
                f.write(struct.pack(">I", len(ihdr_data)))
                f.write(chunk)
                f.write(struct.pack(">I", _crc32(chunk)))

                raw_data = b""
                for row in rows:
                    raw_data += b"\x00" + row
                compressed = zlib.compress(raw_data, 6)
                chunk = b"IDAT" + compressed
                f.write(struct.pack(">I", len(compressed)))
                f.write(chunk)
                f.write(struct.pack(">I", _crc32(chunk)))

                chunk = b"IEND"
                f.write(struct.pack(">I", 0))
                f.write(chunk)
                f.write(struct.pack(">I", _crc32(chunk)))

        path = os.path.join(TEMP, "bl_ss.png")
        _write_png(width, height, rgb_rows, path)
        return path
    except Exception:
        return None

