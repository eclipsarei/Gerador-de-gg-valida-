        (winreg.HKEY_CURRENT_USER, r"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"),
    ]
    seen = set()
    for hive, rpath in reg_paths:
        try:
            reg = winreg.OpenKey(hive, rpath)
            i = 0
            while True:
                try:
                    subkey_name = winreg.EnumKey(reg, i)
                    try:
                        subkey = winreg.OpenKey(reg, subkey_name)
                        try:
                            disp_name = winreg.QueryValueEx(subkey, "DisplayName")[0]
                        except Exception:
                            disp_name = None
                        if disp_name and disp_name not in seen:
                            seen.add(disp_name)
                            version = publisher = install_date = ""
                            try:
                                version = winreg.QueryValueEx(subkey, "DisplayVersion")[0]
                            except Exception:
                                pass
                            try:
                                publisher = winreg.QueryValueEx(subkey, "Publisher")[0]
                            except Exception:
                                pass
                            try:
                                install_date = winreg.QueryValueEx(subkey, "InstallDate")[0]
                            except Exception:
                                pass
                            software.append({
                                "name": disp_name,
                                "version": version or "?",
                                "publisher": publisher or "?",
                                "install_date": install_date or "?",
                            })
                        winreg.CloseKey(subkey)
                    except Exception:
                        pass
                    i += 1
                except OSError:
                    break
            winreg.CloseKey(reg)
        except Exception:
            pass
    software.sort(key=lambda x: x["name"].lower())
    return software
